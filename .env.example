# 后端环境配置：复制为 .env，再填写本机需要的密码和密钥。
# Vite 只使用 PRISM_AGENT_API_URL 来转发接口，其余值由后端或 Docker 使用。
# 后端：uv run --env-file .env langgraph dev --host 127.0.0.1 --port 2024
# 前端：pnpm dev
# Windows 下统一 Python 配置文件编码，并关闭依赖 colorama 的日志颜色。
PYTHONUTF8=1
LOG_COLOR=false
# 后端 SDK 调用 Agent Server 的地址，Vite 也用它作为转发目标。
PRISM_AGENT_API_URL=http://127.0.0.1:2024
# 对应 langgraph.json 的 graphs 中注册的图名。
PRISM_GRAPH_ID=prism_research
# 业务数据库通过 SSH 隧道连接远端：127.0.0.1:15433 -> 远端 127.0.0.1:15433。
# 密码只填写在本机 .env；应用角色不拥有 PostgreSQL 超级用户权限。
PRISM_DATABASE_URL=postgresql://prism_app:CHANGE_ME@127.0.0.1:15433/prism_research
# 同一本地端口只启动一条 SSH 隧道；示例中的私钥、用户和地址需替换。
# ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:15433:127.0.0.1:15433 -i ~/.ssh/your_key ssh_user@server.example.com
# 线上容器请将连接串主机改为数据库所在网络中可达的地址。
PRISM_POSTGRES_PORT=15433
# 只供 database.compose.yaml 启动数据库使用的管理员密码。
PRISM_POSTGRES_ADMIN_PASSWORD=
# 后端调用 Agent Server 时允许等待的秒数。
PRISM_REQUEST_TIMEOUT_SECONDS=30
# 模型 API Key 的服务端加密根密钥；请备份，所有后端实例必须保持相同值。
# 生成：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRISM_MODEL_ENCRYPTION_KEY=

# 开启追踪需同时填写 API key，并把 TRACING 改为 true。
# 未配置时仍能验证本地图编译、SDK 调用和结果持久化。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# 追踪记录归到哪个项目，以及发送到哪个 LangSmith 服务。
LANGSMITH_PROJECT=prism-research-studio
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 多工作空间账号按需要填写。
LANGSMITH_WORKSPACE_ID=

# Studio 需要直接连接 Agent Server；远程环境改为浏览器可达的地址。
PRISM_AGENT_PUBLIC_URL=http://127.0.0.1:2024

# 生产 Agent Server 使用 PostgreSQL / Redis，不能用 inmem 代替。
# 以下值由部署环境提供；不提交实际连接凭据或 license key。
DATABASE_URI=
REDIS_URI=
LANGGRAPH_CLOUD_LICENSE_KEY=
# deploy/compose.yaml 中 Agent Server 自带 PostgreSQL 的密码，不是业务库密码。
POSTGRES_PASSWORD=
